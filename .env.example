# Copy to .env, then `docker compose up -d` (or `docker compose up --build`).

# Runtime
PUID=1000
PGID=1000
TZ=Europe/Warsaw
# ASTERISK_ARGS=-g
# ASTERISK_TERMINAL_OPTS=      # "" drops -W ; "-B" dark bg ; "-n" no color
# ASTERISK_IMAGE=ghcr.io/pmastalerz/asterisk:latest

# Build (only needed for `docker compose build` / `up --build`; CI passes these itself)
ASTERISK_VERSION=22.11.0
ASTERISK_SHA256=3bd5ee040509a3d3cd9b1ba9520c18e6ec0a7e7981ca68c457dcd36ba3c54d94
VERSION=dev
