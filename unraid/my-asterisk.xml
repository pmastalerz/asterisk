<?xml version="1.0"?>
<Container version="2">
  <Name>asterisk</Name>
  <Repository>ghcr.io/pmastalerz/asterisk:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/pmastalerz/asterisk/issues</Support>
  <Project>https://www.asterisk.org/</Project>
  <Overview>
Asterisk LTS built from official sources, packaged for Unraid.&#13;
&#13;
Map config + mutable data only (db / keys / sounds). Do not bind the whole /var/lib/asterisk — that hides documentation from the image and Asterisk will not start.&#13;
&#13;
Host network is usually simplest for SIP + RTP.
  </Overview>
  <Category>Network:Other:Tools:</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/pmastalerz/asterisk/main/unraid/my-asterisk.xml</TemplateURL>
  <Icon>https://www.asterisk.org/wp-content/uploads/asterisk-logo.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Asterisk config" Target="/etc/asterisk" Default="/mnt/user/appdata/asterisk/etc" Mode="rw" Description="PJSIP, dialplan, rtp, modules" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/asterisk/etc</Config>
  <Config Name="AstDB" Target="/var/lib/asterisk/db" Default="/mnt/user/appdata/asterisk/db" Mode="rw" Description="Persistent AstDB (sqlite)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/asterisk/db</Config>
  <Config Name="Keys" Target="/var/lib/asterisk/keys" Default="/mnt/user/appdata/asterisk/keys" Mode="rw" Description="TLS / keys" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/asterisk/keys</Config>
  <Config Name="Sounds" Target="/var/lib/asterisk/sounds" Default="/mnt/user/appdata/asterisk/sounds" Mode="rw" Description="Custom sound files (optional)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/asterisk/sounds</Config>
  <Config Name="Asterisk logs" Target="/var/log/asterisk" Default="/mnt/user/appdata/asterisk/log" Mode="rw" Description="Logs" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/asterisk/log</Config>
  <Config Name="Asterisk spool" Target="/var/spool/asterisk" Default="/mnt/user/appdata/asterisk/spool" Mode="rw" Description="Voicemail, monitor, spool" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/asterisk/spool</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User id (Unraid default share user is often 99)" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group id (Unraid users group is often 100)" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Warsaw" Mode="" Description="Timezone" Type="Variable" Display="always" Required="false" Mask="false">Europe/Warsaw</Config>
</Container>
